{
  // Il nome deve essere identico al nome del progetto su Cloudflare (Workers & Pages).
  "name": "scadenziario",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  // Le pagine stanno in public/ e si servono gratis e senza limiti.
  // Solo le richieste che iniziano con /api/ passano dal programma in src/worker.js.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // Collegamento al database. Sostituire database_id con l'ID mostrato nella pagina del database su Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scadenzario",
      "database_id": "dfcb22e6-9374-4cd0-a17a-988d3fde8f93"
    }
  ]
}
